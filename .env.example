# Supabase Configuration
# Get these values from your Supabase project: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example values (replace with your own):
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxx

# For production builds, copy this file to .env.production:
# cp .env.example .env.production
# Then update with your production Supabase credentials

